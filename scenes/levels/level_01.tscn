[sub_resource type="GDScript" id="GDScript_qpro0"]
resource_name = "scr3"
script/source = "extends Area2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.


func _on_body_entered(body: Node2D) -> void:
	if body is Entity and body.is_in_group(\"player\"):
		#>----<#
		Game.dialogue.emit([
			[
				\"Budi\",
				\"siapa itu cu?\"
			],
			[
				\"Budi\",
				\"aduh... kok ngantuk ya.....?\"
			]
		])
		body.speed /= 2
		#>----<#
		collision_mask = 0
		await Game.level_reset
		collision_mask = 0b0001
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_2ehep"]
size = Vector2(128, 128)

[sub_resource type="GDScript" id="GDScript_xrovt"]
resource_name = "scr4"
script/source = "extends Area2D

signal a
var b: bool = false
var c: bool = false
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if b or c:
		#-64, 3264
		$Doni.position += Vector2.LEFT * delta*512
		if b and $Doni.position.x <= -64:
			a.emit()
			b = false


func _on_body_entered(body: Node2D) -> void:
	if body is Entity and body.is_in_group(\"player\"):
		collision_mask = 0
		#>----<#

		Game.dialogue.emit([
			[
				\"Budi\", \"siapa tuh?\"
			]
		])
		await Game.dialogue_finished
		await get_tree().process_frame
		body.controllable = false
		b = true
		await a
		Game.dialogue.emit([
			[
				\"Budi\", \"D-D-DONI?\"
			],
			[
				\"Budi\", \"WOI DONI, INI GUA!\"
			],
			[
				\"Doni\", \"...\"
			],
			[
				\"Budi\", \"DONI!\"
			],
		])
		await Game.dialogue_finished
		body.controllable = false
		c = true
		$\"../Overlay\".show()
		var tween = get_tree().create_tween()
		tween.tween_property($\"../Overlay/ColorRect\", \"color:a\", 1.0, 2.0)
		await tween.finished
		Game.level_won.emit()
		#>----<#
"

