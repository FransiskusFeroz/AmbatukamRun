[sub_resource type="GDScript" id="GDScript_0acyy"]
resource_name = "scr2"
script/source = "extends Area2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Game.checkpoint_reached.connect(queue_free)




func _on_body_entered(body: Node2D) -> void:
	if body is Entity and body.is_in_group(\"player\"):
		#>----<#
		Game.dialogue.emit([
			[\"Budi\", \"\",
			\"res://assets/dialogue/ar1.png\"]
		])
		#>----<#
		collision_mask = 0
		await Game.level_reset
		collision_mask = 0b0001
"

