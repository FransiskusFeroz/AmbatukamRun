[sub_resource type="GDScript" id="GDScript_h477h"]
resource_name = "scr"
script/source = "extends Area2D

var d1 = [
	[
		\"Budi\", \"Cok\"
	],[
		\"Budi\", \"Ada pisang goreng\"
	],[
		\"Budi\", \"Gua gak makan dari tadi anjir, pas bener\"
	]
]

var d2 = [
	[
		\"Budi\", \"[i]*memakan pisang goreng*[/i] akhirnya...\"
	], [
		\"Budi\", \"Gw keluarnya lewat mana ya?\"
	]
]



func _on_body_entered(body: Node2D) -> void:
	if body is PlayerEntity:
		collision_mask = 0
		Game.dialogue.emit(d1)
		body.glide(Vector2(256, 1536))
		await body.glide_finished
		Game.dialogue.emit(d2)
		await Game.dialogue_finished
		queue_free()
"

