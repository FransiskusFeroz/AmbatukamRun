[sub_resource type="GDScript" id="GDScript_7m4g7"]
resource_name = "Button Adjustments"
script/source = "@tool

extends CanvasLayer


func _ready():

	if not Engine.is_editor_hint():
		$\"../Vision\".show()
		$\"../Background\".show()
		%StaminaBar.max_value = $\"..\".max_stamina
		%HealthBar.max_value = $\"..\".max_health
	else:
		$\"../Vision\".hide()
		$\"../Background\".hide()


func _process(_delta):
	if not Engine.is_editor_hint():
		$CtrlRoot/AttackButton.global_position.x = get_viewport().get_visible_rect().size\\
				.x - (128 + 128)
		$CtrlRoot/DashButton.global_position.x = get_viewport().get_visible_rect().size\\
				.x - (128 + 1)

		%StaminaBar.value = $\"..\".stamina
		%HealthBar.value = get_parent().health
"

